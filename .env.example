# Copy to .env and fill in. The setup wizard writes DISCORD_BOT_TOKEN and the
# Google Drive keys for you; the rest are optional and edited by hand.

# --- Required ---
# Your Discord bot token (the setup wizard asks for this on first run).
DISCORD_BOT_TOKEN=
# Your Discord application (client) ID. Optional; falls back to the bot's own ID.
DISCORD_CLIENT_ID=
# Your own Discord user ID. Used for DM alerts and @-mentions on update notices.
DISCORD_USER_ID=

# --- Feedback ---
# Where /feedback and the tutorials-page feedback form deliver reports.
#
# Upstream this was hardcoded (base64-encoded) to the original author's private
# Discord channel, so every report — including your Discord tag, user ID, server
# name and guild ID — went to him. That is removed. Point this at a webhook in a
# channel you control, or leave it blank to disable the feature entirely.
# Leaving it blank sends nothing anywhere; there is no fallback destination.
FEEDBACK_WEBHOOK_URL=

# --- Info Accounts dashboard ---
# Set to true to publish the local dashboard on a public Cloudflare Quick Tunnel
# (https://<random>.trycloudflare.com). This downloads cloudflared.exe on first use
# and makes your account pages reachable from the internet — they are gated behind a
# 96-bit random token per account, and trades are refused over the tunnel, but it is
# still your data on a public URL. Off by default (upstream had it always on).
ENABLE_PUBLIC_TUNNEL=false

# --- Alerts channel ---
# Routes the bot's AUTOMATIC notifications to a Discord channel instead of DMing you:
#   - "Webhook(s) down" health alerts
#   - "Instance N stuck at X packs" frozen-instance alerts
#   - the "no updates webhook configured" fallbacks
# It still @-mentions you, so you keep the ping but can mute the channel later.
# Make a webhook in any channel you own:
#   Channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL
# Leave blank and everything DMs you exactly as before. DMs you asked for by pressing a
# button are never routed here.
ALERTS_WEBHOOK_URL=

# --- Auto-update source ---
# The repo the updater fetches version.json from, and the only repo whose release
# assets it will download and run. Upstream this was hardcoded to the original author,
# meaning he could ship code to your machine at any time. Defaults to your own mirror;
# change it here if you ever move the repo. Read by update-checker.js and panel-info.js.
# (The compiled Control Panel has the same value baked in at build time — see
# RepoActualizacion in scripts/ControlPanel.cs — so change it there too and rebuild.)
UPDATE_REPO=chefhousgit/Pokemon-Monitor-TCGP
UPDATE_BRANCH=main

# --- Google Drive (optional, for HD card images) ---
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_HD_ENABLED=false

# --- Ports (optional overrides; services auto-fall-back if these are busy) ---
S4T_PORT=3000
HEARTBEAT_PORT=3003

# --- S4T ingest auth (optional) ---
REQUIRE_INGEST_AUTH=false
INGEST_AUTH_TOKEN=

# --- Manual updates ---
# In-app updating is off because this mirror is private (see RELEASING.md).
# Only set true if you make the repo public.
UPDATE_CHECK_ENABLED=false
